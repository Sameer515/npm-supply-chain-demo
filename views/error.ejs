<%- include('layout', { title: 'Error' }) %>

<div class="max-w-2xl mx-auto text-center py-16">
    <div class="text-9xl font-bold text-red-500 mb-4">500</div>
    <h1 class="text-3xl font-bold text-gray-800 mb-4">Something Went Wrong</h1>
    <p class="text-gray-600 mb-8">We're sorry, but something went wrong on our end. Our team has been notified.</p>
    
    <% if (process.env.NODE_ENV === 'development' && error) { %>
        <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-6 text-left">
            <pre class="text-red-700 text-sm overflow-x-auto"><%= JSON.stringify(error, null, 2) %></pre>
        </div>
    <% } %>
    
    <div class="space-x-4">
        <a href="/" class="inline-block bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition duration-300">
            Go Back Home
        </a>
        <a href="#" onclick="window.location.reload()" class="inline-block bg-gray-200 text-gray-800 px-6 py-3 rounded-lg hover:bg-gray-300 transition duration-300">
            Try Again
        </a>
    </div>
</div>
