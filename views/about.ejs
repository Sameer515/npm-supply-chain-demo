<%- include('layout', { title: 'About Us' }) %>

<div class="max-w-4xl mx-auto">
    <div class="bg-white rounded-lg shadow-lg p-8 mb-8">
        <h1 class="text-3xl font-bold text-gray-800 mb-6">About Our Company</h1>
        <p class="text-gray-600 mb-6">
            We are a leading provider of supply chain solutions, helping businesses streamline their operations 
            and improve efficiency. Our team of experts is dedicated to delivering top-notch services to our clients.
        </p>
        <p class="text-gray-600">
            With years of experience in the industry, we understand the challenges businesses face in managing 
            their supply chains. Our mission is to provide innovative solutions that help our clients stay ahead 
            of the competition.
        </p>
    </div>

    <div class="bg-white rounded-lg shadow-lg p-8">
        <h2 class="text-2xl font-semibold text-gray-800 mb-6">Our Team</h2>
        <div class="grid md:grid-cols-3 gap-6">
            <% team.forEach(member => { %>
                <div class="bg-gray-50 p-6 rounded-lg text-center">
                    <div class="w-24 h-24 bg-blue-200 rounded-full mx-auto mb-4 flex items-center justify-center text-3xl text-blue-600">
                        <%= member.name.split(' ').map(n => n[0]).join('') %>
                    </div>
                    <h3 class="text-xl font-semibold"><%= member.name %></h3>
                    <p class="text-blue-600"><%= member.role %></p>
                </div>
            <% }) %>
        </div>
    </div>
</div>
