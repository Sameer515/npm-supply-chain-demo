<%- include('layout', { title: 'Our Products' }) %>

<div class="max-w-6xl mx-auto">
    <div class="bg-white rounded-lg shadow-lg p-8 mb-8">
        <h1 class="text-3xl font-bold text-gray-800 mb-2">Our Products</h1>
        <p class="text-gray-600 mb-8">Discover our range of high-quality products</p>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            <% products.forEach(product => { %>
                <div class="border rounded-lg overflow-hidden shadow-md hover:shadow-lg transition-shadow duration-300">
                    <div class="h-48 bg-gray-200 flex items-center justify-center">
                        <span class="text-4xl text-gray-400">📦</span>
                    </div>
                    <div class="p-6">
                        <h3 class="text-xl font-semibold mb-2"><%= product.name %></h3>
                        <p class="text-blue-600 text-lg font-bold mb-4">$<%= product.price.toFixed(2) %></p>
                        <button class="w-full bg-blue-600 text-white py-2 rounded-lg hover:bg-blue-700 transition duration-300">
                            Add to Cart
                        </button>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
    
    <div class="bg-white rounded-lg shadow-lg p-8">
        <h2 class="text-2xl font-semibold text-gray-800 mb-4">Why Choose Our Products?</h2>
        <ul class="space-y-3">
            <li class="flex items-start">
                <span class="text-green-500 mr-2">✓</span>
                <span>High-quality materials</span>
            </li>
            <li class="flex items-start">
                <span class="text-green-500 mr-2">✓</span>
                <span>Competitive pricing</span>
            </li>
            <li class="flex items-start">
                <span class="text-green-500 mr-2">✓</span>
                <span>Fast shipping</span>
            </li>
            <li class="flex items-start">
                <span class="text-green-500 mr-2">✓</span>
                <span>30-day money-back guarantee</span>
            </li>
        </ul>
    </div>
</div>
