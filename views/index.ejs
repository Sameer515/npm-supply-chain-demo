<%- include('layout', { title: 'Home' }) %>

<div class="max-w-4xl mx-auto text-center py-12">
    <h1 class="text-4xl font-bold text-gray-800 mb-6">Welcome to SupplyChain Demo</h1>
    <p class="text-xl text-gray-600 mb-8"><%= message %></p>
    
    <div class="bg-white rounded-lg shadow-lg p-6 mb-8">
        <h2 class="text-2xl font-semibold mb-4">Our Services</h2>
        <div class="grid md:grid-cols-3 gap-6 mt-6">
            <div class="bg-blue-50 p-6 rounded-lg">
                <div class="text-blue-600 text-4xl mb-4">🚚</div>
                <h3 class="text-xl font-semibold mb-2">Fast Delivery</h3>
                <p class="text-gray-600">Quick and reliable shipping to your doorstep</p>
            </div>
            <div class="bg-green-50 p-6 rounded-lg">
                <div class="text-green-600 text-4xl mb-4">🔄</div>
                <h3 class="text-xl font-semibold mb-2">Real-time Tracking</h3>
                <p class="text-gray-600">Track your orders in real-time</p>
            </div>
            <div class="bg-purple-50 p-6 rounded-lg">
                <div class="text-purple-600 text-4xl mb-4">🛡️</div>
                <h3 class="text-xl font-semibold mb-2">Secure Payments</h3>
                <p class="text-gray-600">Safe and secure payment options</p>
            </div>
        </div>
    </div>
    
    <a href="/products" class="inline-block bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition duration-300">
        View Our Products
    </a>
</div>
